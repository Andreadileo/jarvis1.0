# Anthropic (console.anthropic.com) — fatturazione API separata dai crediti Claude Code
ANTHROPIC_API_KEY=sk-ant-...
# Verifica gli ID aggiornati su https://docs.claude.com/en/docs/about-claude/models
CHAT_MODEL=claude-sonnet-4-5
TRIAGE_MODEL=claude-haiku-4-5

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+39...
USER_PHONE_NUMBER=+39...
# In produzione lascia true: rifiuta i webhook non firmati da Twilio
VERIFY_TWILIO_SIGNATURE=true

# URL pubblico del server (ngrok in locale, dominio in produzione), senza slash finale
PUBLIC_URL=https://example.ngrok-free.app

# Canale non urgente: bot Telegram (@BotFather -> token, @userinfobot -> chat id)
# Se vuoti, le notifiche finiscono solo nei log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Fonte calendario: URL iCal privato (Google Calendar -> Impostazioni -> Indirizzo segreto
# in formato iCal). Più URL separati da virgola. Vuoto = watcher spento.
CALENDAR_ICS_URLS=
CALENDAR_LOOKAHEAD_MINUTES=45

# Fonte email: IMAP in sola lettura (Gmail richiede una app password).
# Senza VIP né parole chiave il watcher resta spento: meglio muto che invadente.
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_VIP_SENDERS=capo@azienda.it,@clienteimportante.com
IMAP_KEYWORDS=urgente,scadenza,bonifico

# Token per POST /events e POST /briefing (qualunque stringa lunga e casuale)
INBOUND_TOKEN=

# Guardrail
TIMEZONE=Europe/Rome
QUIET_HOURS_START=23
QUIET_HOURS_END=8
MAX_CALLS_PER_DAY=3
CALL_URGENCY_THRESHOLD=8
MAX_NOTIFICATIONS_PER_HOUR=4

# Iniziativa
BRIEFING_ENABLED=true
BRIEFING_HOUR=8

# Voce
LANGUAGE=it-IT
WATCH_INTERVAL_SECONDS=120
DB_PATH=jarvis.db
