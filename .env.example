# Anthropic (console.anthropic.com) — fatturazione API separata dai crediti Claude Code
ANTHROPIC_API_KEY=sk-ant-...
# Verifica gli ID aggiornati su https://docs.claude.com/en/docs/about-claude/models
CHAT_MODEL=claude-sonnet-4-5
TRIAGE_MODEL=claude-haiku-4-5

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+39...
USER_PHONE_NUMBER=+39...

# URL pubblico del server (ngrok in locale, dominio in produzione), senza slash finale.
# Deve coincidere con l'URL che Twilio chiama: serve anche per verificare la firma.
PUBLIC_URL=https://example.ngrok-free.app
# Solo sviluppo locale: salta la verifica della firma X-Twilio-Signature. Mai in produzione.
TWILIO_SKIP_SIGNATURE_CHECK=false
# Token per POST /debug/call (header X-Debug-Token). Vuoto = endpoint disattivato.
DEBUG_TOKEN=

# Guardrail
TIMEZONE=Europe/Rome
QUIET_HOURS_START=23
QUIET_HOURS_END=8
MAX_CALLS_PER_DAY=3
CALL_URGENCY_THRESHOLD=8

# Voce (provider e voce TTS di ConversationRelay; Bianca-Neural è una voce italiana Amazon Polly)
LANGUAGE=it-IT
TTS_PROVIDER=Amazon
TTS_VOICE=Bianca-Neural
WATCH_INTERVAL_SECONDS=120
DB_PATH=jarvis.db
