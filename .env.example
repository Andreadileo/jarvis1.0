# Anthropic (console.anthropic.com) — fatturazione API separata dai crediti Claude Code
ANTHROPIC_API_KEY=sk-ant-...
# Verifica gli ID aggiornati su https://docs.claude.com/en/docs/about-claude/models
CHAT_MODEL=claude-sonnet-4-5
TRIAGE_MODEL=claude-haiku-4-5

# Telegram (gratuito): bot da @BotFather, chat id da https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=
TELEGRAM_VOICE_NOTES=true          # nota vocale oltre al testo (serve ffmpeg nel PATH)

# Voce locale (gratuita). Vuoti = voce di Windows (SAPI). Piper suona meglio: https://github.com/rhasspy/piper
PIPER_PATH=
PIPER_MODEL=
PRESENCE_IDLE_SECONDS=120          # oltre questa inattivita' sei "lontano dal PC" -> Telegram invece della voce

# Twilio (opzionale: solo se vuoi davvero la telefonata quando sei lontano dal PC)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
USER_PHONE_NUMBER=

# URL pubblico del server (ngrok in locale, dominio in produzione), senza slash finale
PUBLIC_URL=https://example.ngrok-free.app

# Guardrail
TIMEZONE=Europe/Rome
QUIET_HOURS_START=23
QUIET_HOURS_END=8
MAX_CALLS_PER_DAY=3
CALL_URGENCY_THRESHOLD=8

# Voce
LANGUAGE=it-IT
WATCH_INTERVAL_SECONDS=120
DB_PATH=jarvis.db
